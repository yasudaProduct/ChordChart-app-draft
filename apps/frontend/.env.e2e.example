# E2Eテスト用環境変数
# このファイルをコピーして .env.e2e を作成してください
#
# 注意: @clerk/testing の setupClerkTestingToken を使用するため、
#       CLERK_SECRET_KEY は sk_test_ で始まるテスト用キーが必須です。
#       sk_live_ の本番キーでは動作しません。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXX
NEXT_PUBLIC_API_URL=http://localhost:8080/api
